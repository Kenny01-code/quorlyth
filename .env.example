# Copy this file to .env and paste YOUR key. Never commit .env and never put the key in src/.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_QUICK_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional legacy TTS fallback. Voice order defaults to Grok, Gemini, ElevenLabs, then OpenAI.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# For Nigerian/British accents, configure an actual matching voice ID from your ElevenLabs account.
# ELEVENLABS_VOICE_NIGERIAN_ID=
# ELEVENLABS_VOICE_BRITISH_ID=

# Preferred provider; unavailable providers fall through to the next configured provider.
# auto tries Grok, then Gemini, then OpenAI for text; voice also falls back across Grok and Gemini.
AI_PROVIDER=auto
AI_PROVIDER_TIMEOUT_MS=7000
AI_FIRST_TOKEN_TIMEOUT_MS=5000
AI_STREAM_IDLE_TIMEOUT_MS=15000
AI_TTS_PROVIDER_TIMEOUT_MS=8000
# Store real API keys in Vercel Environment Variables, not in source files.
# Optional; server-only YouTube Data API v3 enrichment for live idea reviews.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_QUICK_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Optional Grok provider. Set AI_PROVIDER=grok to use it for bot chat and JSON skills.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_QUICK_MODEL=grok-4.7

# Optional: real accounts (Google, email) and a shared database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
